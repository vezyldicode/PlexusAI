{
  "name": "plexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous multi-agent development system driving Claude Code and Codex CLI accounts",
  "bin": {
    "plexus": "src/cli/plexus.ts"
  },
  "scripts": {
    "start": "node src/server/main.ts --open",
    "daemon": "node src/server/main.ts",
    "stop": "node src/cli/plexus.ts shutdown",
    "plexus": "node src/cli/plexus.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.ts\" \"prototypes/**/*.test.mjs\"",
    "test:unit": "node --test --test-timeout=60000 test/adapters.test.ts test/scheduler.test.ts test/prompts.test.ts test/app.test.ts test/git.test.ts test/speed.test.ts",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "desktop": "npm --prefix desktop start",
    "desktop:win": "npm --prefix desktop run dist:win",
    "desktop:linux": "npm --prefix desktop run dist:linux"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
